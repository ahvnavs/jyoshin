[Unit]
Description=Kazeshini (Server Truth Engine for Linux)
Documentation=https://github.com/OWNER/kazeshini
After=network.target
Wants=network.target

[Service]
Type=simple
User=kazeshini
Group=kazeshini
ExecStart=/usr/local/bin/kazeshini serve --config /etc/kazeshini/kazeshini.json
Restart=always
RestartSec=5s

# Hard resource limits: Never harm the host
MemoryMax=128M
CPUQuota=10%
TasksMax=64
IOWeight=20
Nice=10

# Hardened sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE

# Persistent State and Runtime directory
StateDirectory=kazeshini
StateDirectoryMode=0700
RuntimeDirectory=kazeshini
RuntimeDirectoryMode=0755
ConfigurationDirectory=kazeshini
ConfigurationDirectoryMode=0755

# Read-only enforcement of sensitive kernel and proc nodes
ReadOnlyPaths=/proc /sys
ReadWritePaths=/var/lib/kazeshini

[Install]
WantedBy=multi-user.target

