# Maintainer: Kazeshini Authors <maintainers@kazeshini.dev>
pkgname=kazeshini
pkgver=0.1.0
pkgrel=0
pkgdesc="Server Truth Engine for Linux"
url="https://github.com/OWNER/kazeshini"
arch="x86_64 aarch64"
license="Apache-2.0"
makedepends="go"
source="$pkgname-$pkgver.tar.gz::https://github.com/OWNER/kazeshini/archive/v$pkgver.tar.gz"

build() {
    export CGO_ENABLED=0
    go build -trimpath -ldflags "-s -w -X 'main.Version=v$pkgver'" -o kazeshini ./cmd/kazeshini
}

check() {
    go test ./...
}

package() {
    install -Dm755 kazeshini "$pkgdir"/usr/local/bin/kazeshini
    install -Dm644 packaging/config/kazeshini.json "$pkgdir"/etc/kazeshini/kazeshini.json
}

